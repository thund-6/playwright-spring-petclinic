# Copy to .env before the first `docker compose up`:
#
#   cp .env.example .env
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# Keep files the Playwright container writes into ./playwright owned by you,
# not root (bash can't export these portably, so compose reads them from here).
UID=1000
GID=1000

# Pinned everywhere - a mismatch is an off-by-one-day flake waiting to happen
# (the Angular app formats dates with moment() in the browser's local zone).
TZ=UTC

# NOTE: POSTGRES_PASSWORD is consumed by the postgres image; the REST app reads
# POSTGRES_PASS. Near-identical names, different consumers - see docker-compose.yml.
POSTGRES_DB=petclinic
POSTGRES_USER=petclinic
POSTGRES_PASSWORD=petclinic

ANGULAR_HOST_PORT=8080
REST_HOST_PORT=9966
POSTGRES_HOST_PORT=55432
PW_UI_PORT=9323

# Baked into the Angular image at build time - changing these does nothing
# until `docker compose build angular`. Relative, so the browser calls its
# own origin and nginx proxies /petclinic/api/ to the rest service (see
# docker/nginx.conf) - this must stay same-origin for both a human hitting
# localhost:8080 and Playwright hitting angular:8080 to work without CORS.
REST_API_URL=/petclinic/api/
BASE_HREF=/petclinic/

# Must stay in lockstep with the @playwright/test version in playwright/package.json,
# or the client drifts off the browser revisions baked into the image.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble
